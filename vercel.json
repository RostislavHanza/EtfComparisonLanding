{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance",
      "schedule": "15 3 * * *"
    }
  ],
  "functions": {
    "api/comparisons.ts": {
      "maxDuration": 60
    },
    "api/mail-health.ts": {
      "maxDuration": 60
    }
  }
}
