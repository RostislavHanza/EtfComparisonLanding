{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/etf-sync",
      "schedule": "0 4 * * 1"
    }
  ],
  "functions": {
    "api/comparisons.ts": {
      "maxDuration": 60
    },
    "api/mail-health.ts": {
      "maxDuration": 60
    },
    "api/etf-sync.ts": {
      "maxDuration": 60
    },
    "api/preview-admin.ts": {
      "maxDuration": 60
    },
    "api/performance.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/add",
      "destination": "/ads/index.html"
    },
    {
      "source": "/add/",
      "destination": "/ads/index.html"
    }
  ]
}
