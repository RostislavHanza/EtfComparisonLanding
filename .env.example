# Server only. Never prefix a privileged key with VITE_. No credentials here.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead of SECRET_KEY.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Google application password, never the account password
SMTP_PASSWORD=
EMAIL_FROM=
APP_BASE_URL=http://localhost:5173
APP_ENV=development
# Generate at least 32 random characters; never commit the actual value.
RATE_LIMIT_SECRET=
# Preview/development deny all recipients unless explicitly listed.
PREVIEW_RECIPIENTS=
# Optional exact origins, separated by commas. Do not use wildcard origins.
ALLOWED_ORIGINS=

# Real controller identity/contact; required before accepting personal data
OPERATOR_NAME=
OPERATOR_CONTACT=
# Random >=32-character secret protecting daily retention cleanup
CRON_SECRET=
